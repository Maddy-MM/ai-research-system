# Secret key used to sign JWT tokens (keep this long and random)
JWT_SECRET_KEY=your_jwt_secret_key_here

# API key for Tavily search service
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Model override (optional, defaults to gpt-5-nano; e.g. gpt-5.6-luna or gpt-5-nano)
OPENAI_MODEL=gpt-5.6-luna

# Reasoning effort override (optional: none, low, medium, high - function tools require none)
OPENAI_REASONING_EFFORT=none

# FastMCP tool server configuration
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8001

# LangSmith tracing (optional — set to true to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=researchmind