# ============================================================
# ResearchMind Environment Configuration Template
# ============================================================

# --- OpenAI Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano

# --- Search & Retrieval ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Authentication & Session Security ---
JWT_SECRET_KEY=your_long_random_jwt_secret_here
DEMO_USERNAME=admin
DEMO_PASSWORD=secret

# --- Database Persistence ---
# Defaults to local SQLite ('sqlite:///./research.db') if omitted.
# For Supabase / PostgreSQL persistence, provide your connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./research.db

# --- MCP Tool Server & Observability (Optional) ---
MCP_SERVER_URL=http://localhost:8001/mcp
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=researchmind
